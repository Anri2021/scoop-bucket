{
  "$schema": "https://raw.githubusercontent.com/Anri2021/scoop-bucket/main/schemas/recipes.schema.json",
  "engine": { "version": 4, "default_policy": "universal-first", "default_architectures": [ "64bit" ] },
  "recipes": [
    { "name": "bun", "description": "Incredibly fast JavaScript runtime and toolkit", "homepage": "https://bun.sh", "license": "MIT", "source_type": "github", "repo": "oven-sh/bun", "mode": "upstream", "platform_policy": "universal-first", "architectures": [ "64bit" ], "asset_pattern": "^bun-windows-x64\\.zip$", "version_regex": "(?<version>\\d+\\.\\d+\\.\\d+)", "extract_dir": "bun-windows-x64", "bin": "bun.exe", "toolchain": true, "bootstrap_exe": "bun.exe" },
    { "name": "headplane", "description": "A frontend for headscale", "homepage": "https://github.com/tale/headplane", "license": "AGPL-3.0-only", "source_type": "github", "repo": "tale/headplane", "mode": "cloud", "platform_policy": "universal-first", "architectures": [ "64bit" ], "build_type": "node", "bin": "headplane.cmd", "depends": [ "nodejs" ], "persist": [ "config.yaml", "data" ], "compression_level": 5 },
    { "name": "ipv6-advertiser", "description": "IPv6 Router Advertisement Daemon", "homepage": "https://github.com/Anri2021/ipv6-advertiser", "license": "MIT", "source_type": "github", "repo": "Anri2021/ipv6-advertiser", "mode": "cloud", "platform_policy": "universal-first", "architectures": [ "64bit" ], "build_type": "python", "entrypoint": "ipv6-advertiser.py", "bin": "ipv6-advertiser.exe", "persist": [ "ipv6-advertiser.example.conf" ], "compression_level": 5 },
    { "name": "ddns-dynu", "description": "Dynu DDNS IP update utility", "homepage": "https://github.com/Anri2021/ddns-dynu", "license": "MIT", "source_type": "github", "repo": "Anri2021/ddns-dynu", "mode": "upstream", "platform_policy": "universal-first", "architectures": [ "64bit" ], "asset_pattern": "^ddns-dynu\\.ps1$", "extra_assets": [ "^ddns-dynu\\.conf$" ], "bin": "ddns-dynu.ps1", "persist": [ "ddns-dynu.conf" ] }
    { "name": "dex", "description": "OpenID Connect (OIDC) and OAuth 2.0 Identity Provider", "homepage": "https://dexidp.com/", "license": "Apache-2.0", "repo": "dexidp/dex", "mode": "cloud", "bin": "dex.exe" },
    { "name": "headscale", "description": "An open source, self-hosted implementation of the Tailscale control server", "homepage": "https://github.com/juanfont/headscale", "license": "BSD-3-Clause", "repo": "juanfont/headscale", "mode": "auto", "bin": "headscale.exe" }
  ]
}

