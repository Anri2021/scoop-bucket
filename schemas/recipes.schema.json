{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Anri2021/scoop-bucket/main/schemas/recipes.schema.json",
  "title": "Meta-Bucket recipes",
  "type": "object",
  "required": [ "recipes" ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "engine": {
      "type": "object",
      "properties": {
        "version": { "const": 4 },
        "default_policy": { "enum": [ "universal-first", "native-first", "force-local" ] },
        "default_architectures": { "$ref": "#/$defs/architectures" }
      },
      "additionalProperties": false
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/recipe" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "architectures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": [ "64bit", "arm64" ] }
    },
    "recipe": {
      "type": "object",
      "required": [ "name", "description", "homepage", "license" ],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "description": { "type": "string", "minLength": 1 },
        "homepage": { "type": "string", "format": "uri" },
        "license": { "type": "string", "minLength": 1 },
        "source_type": { "enum": [ "github", "pypi" ], "default": "github" },
        "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "package": { "type": "string" },
        "mode": { "enum": [ "auto", "upstream", "cloud", "hybrid", "local" ], "default": "auto" },
        "platform_policy": { "enum": [ "universal-first", "native-first", "force-local" ], "default": "universal-first" },
        "architectures": { "$ref": "#/$defs/architectures" },
        "hardware_sensitive": { "type": "boolean", "default": false },
        "native_modules": { "type": "boolean", "default": false },
        "cgo": { "type": "boolean", "default": false },
        "build_args": { "type": "array", "items": { "type": "string" } },
        "output_dirs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "build_type": { "enum": [ "auto", "python", "go", "rust", "node", "bun", "powershell" ] },
        "asset_pattern": { "type": "string" },
        "extra_assets": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "version_regex": { "type": "string" },
        "entrypoint": { "type": "string" },
        "output_path": { "type": "string" },
        "local_output": { "type": "string" },
        "bin": {},
        "depends": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "tool_dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "toolchain": { "type": "boolean", "default": false },
        "bootstrap_exe": { "type": "string" },
        "local_commands": { "type": "array", "items": { "type": "string" } },
        "persist": {},
        "shortcuts": {},
        "extract_dir": { "type": "string" },
        "compression_level": { "type": "integer", "minimum": 1, "maximum": 9, "default": 5 }
      },
      "allOf": [
        { "if": { "required": [ "source_type" ], "properties": { "source_type": { "const": "github" } } }, "then": { "required": [ "repo" ] } },
        { "if": { "required": [ "source_type" ], "properties": { "source_type": { "const": "pypi" } } }, "then": { "required": [ "package" ] } },
        { "if": { "required": [ "mode" ], "properties": { "mode": { "enum": [ "cloud", "hybrid", "local" ] } } }, "then": { "required": [ "build_type" ] } }
      ],
      "additionalProperties": false
    }
  }
}
