{
    "version": "0.7.1",
    "description": "A frontend for headscale",
    "homepage": "https://github.com/tale/headplane",
    "license": "AGPL-3.0-only",
    "depends": "nodejs-lts",
    "url": "https://github.com/tale/headplane/archive/refs/tags/v0.7.1.zip#/headplane.dl",
    "hash": "skip",
    "pre_install": [
        "tar -xf \"$dir\\headplane.dl\" -C \"$dir\" --strip-components=1",
        "Remove-Item \"$dir\\headplane.dl\" -Force -ErrorAction SilentlyContinue",
        "Push-Location \"$dir\"",
        "npm install --no-audit --no-fund",
        "npm run build",
        "npm prune --omit=dev",
        "@('@echo off', 'node \"%~dp0build\\server\\index.js\" %*') | Set-Content -Path \"$dir\\headplane.cmd\" -Encoding ASCII",
        "Pop-Location"
    ],
    "bin": "headplane.cmd",
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/tale/headplane/archive/refs/tags/v$version.zip#/headplane.dl"
    }
}
