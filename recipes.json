{
  "$schema": "https://raw.githubusercontent.com/Anri2021/scoop-bucket/main/schemas/recipes.schema.json",
  "engine": { "version": 4, "default_policy": "universal-first", "default_architectures": [ "64bit" ] },
  "recipes": [
    { "name": "bun", "description": "Incredibly fast JavaScript runtime and toolkit", "homepage": "https://bun.sh", "license": "MIT", "source_type": "github", "repo": "oven-sh/bun", "mode": "upstream", "platform_policy": "universal-first", "architectures": [ "64bit" ], "asset_pattern": "^bun-windows-x64\\.zip$", "version_regex": "(?<version>\\d+\\.\\d+\\.\\d+)", "extract_dir": "bun-windows-x64", "bin": "bun.exe", "toolchain": true, "bootstrap_exe": "bun.exe" },
    { "name": "ddns-dynu", "description": "Dynu DDNS IP update utility", "homepage": "https://github.com/Anri2021/ddns-dynu", "license": "MIT", "source_type": "github", "repo": "Anri2021/ddns-dynu", "mode": "upstream", "platform_policy": "universal-first", "architectures": [ "64bit" ], "asset_pattern": "^ddns-dynu\\.ps1$", "extra_assets": [ "^ddns-dynu(\\..+)?\\.conf$" ], "bin": "ddns-dynu.ps1", "persist": [ "ddns-dynu.example.conf" ] },
    { "name": "ipv6-advertiser", "description": "IPv6 Router Advertisement Daemon", "homepage": "https://github.com/Anri2021/ipv6-advertiser", "license": "MIT", "source_type": "github", "repo": "Anri2021/ipv6-advertiser", "mode": "cloud", "platform_policy": "universal-first", "architectures": [ "64bit" ], "build_type": "python", "entrypoint": "ipv6-advertiser.py", "bin": "ipv6-advertiser.cmd", "persist": [ "ipv6-advertiser.example.conf" ], "compression_level": 5 },
    { "name": "scapy", "description": "Interactive packet manipulation program and library", "homepage": "https://scapy.net", "license": "GPL-2.0-only", "source_type": "github", "repo": "secdev/scapy", "mode": "cloud", "platform_policy": "universal-first", "architectures": [ "64bit" ], "build_type": "python", "entrypoint": "scapy/main.py", "bin": "scapy.cmd", "compression_level": 5 },
    { "name": "headscale", "description": "An open source, self-hosted implementation of the Tailscale control server", "homepage": "https://github.com/juanfont/headscale", "license": "BSD-3-Clause", "source_type": "github", "repo": "juanfont/headscale", "mode": "cloud", "platform_policy": "universal-first", "architectures": [ "64bit" ], "build_type": "go", "entrypoint": "./cmd/headscale", "bin": "headscale.exe", "persist": [ "config.yaml" ], "compression_level": 5 },
    { "name": "repomix", "description": "Pack repository contents into a single AI-friendly document", "homepage": "https://repomix.com", "license": "MIT", "source_type": "github", "repo": "yamadashy/repomix", "mode": "cloud", "platform_policy": "universal-first", "architectures": [ "64bit" ], "build_type": "node", "entrypoint": "bin/repomix.cjs", "bin": "repomix.cmd", "compression_level": 5 },
    { "name": "dex", "description": "OpenID Connect (OIDC) and OAuth 2.0 Identity Provider", "homepage": "https://dexidp.com/", "license": "Apache-2.0", "source_type": "github", "repo": "dexidp/dex", "mode": "cloud", "platform_policy": "universal-first", "architectures": [ "64bit" ], "build_type": "go", "entrypoint": "./cmd/dex", "bin": "dex.exe", "persist": [ "config.yaml" ], "compression_level": 5 },
    { "name": "headplane", "description": "A frontend for headscale", "homepage": "https://github.com/tale/headplane", "license": "AGPL-3.0-only", "source_type": "github", "repo": "tale/headplane", "mode": "cloud", "platform_policy": "universal-first", "architectures": [ "64bit" ], "build_type": "node", "entrypoint": "build/server/index.js", "output_dirs": [ "drizzle" ], "bin": "headplane.cmd", "persist": [ "config.yaml", "data" ], "compression_level": 1 }
  ]
}

